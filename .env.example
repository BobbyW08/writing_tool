# Active app database (Neon - new schema, all reads and writes go here)
APP_DATABASE_URL=

# Old Neon database (read-only, used only by copy-from-payload.ts migration script)
DATABASE_URL=

# AI Gateway - routed through Vercel AI Gateway with a plain "anthropic/claude-..." model string.
# On Vercel this is provided automatically via OIDC. For local dev pull it with `vercel env pull`
# or set it directly from the Vercel dashboard (AI Gateway -> API Keys).
AI_GATEWAY_API_KEY=
