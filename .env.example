# Neon Postgres (Vercel Marketplace one-click integration, or https://neon.tech directly)
DATABASE_URL=

# AI Gateway — used by the suggestion/brainstorm pane (Phase 3.5) via the `ai` package,
# routed through Vercel AI Gateway with a plain "anthropic/claude-..." model string
# (no @ai-sdk/anthropic package needed). On Vercel deployments this is provided
# automatically via OIDC — no key required. For local dev, pull it with `vercel env pull`
# or set it directly from the Vercel dashboard (AI Gateway -> API Keys).
AI_GATEWAY_API_KEY=

# Optional. The model the snippet continuity check uses, as an AI Gateway model string.
# Defaults to anthropic/claude-sonnet-4.5 when unset.
CONTINUITY_MODEL=

# Only needed if/when Phase 5's "re-sync from Drive" button is built — reuses the existing
# Apps Script Drive->GitHub pipeline pattern rather than a Google OAuth client here.
