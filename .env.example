# Old Neon database (read-only after migration is verified; used by migration script only)
DATABASE_URL=

# AI Gateway - routed through Vercel AI Gateway with a plain "anthropic/claude-..." model string.
# On Vercel this is provided automatically via OIDC. For local dev pull it with `vercel env pull`
# or set it directly from the Vercel dashboard (AI Gateway -> API Keys).
AI_GATEWAY_API_KEY=

# Optional. The model the snippet continuity check uses, as an AI Gateway model string.
# Defaults to anthropic/claude-sonnet-4.5 when unset.
CONTINUITY_MODEL=

# Payload CMS - new Neon database (Payload only, never point old code or migration at this)
PAYLOAD_DATABASE_URL=
PAYLOAD_DATABASE_URL_UNPOOLED=

# Payload CMS secret key - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Dev autoLogin: set to your admin account email so the admin skips the login screen locally.
# Leave blank or unset in production.
DEV_LOGIN_EMAIL=
